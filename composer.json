{
    "name": "mousr/templates",
    "description": "A strict and simple template engine for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mousr\\Templates\\": "src/"
        }
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --allow-risky=yes --dry-run",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes"
    }
}
