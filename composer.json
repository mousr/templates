{
    "name": "mousr/templates",
    "description": "A strict and simple template engine for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mousr\\Templates\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mousr\\Templates\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5"
    },
    "suggest": {
        "mousr/templates-phpstan-extension": "To get PHPStan support"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --allow-risky=yes --dry-run",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes",
        "stan": "phpstan analyse --memory-limit 4G -v",
        "unit": "phpunit --testsuite=Unit"
    }
}
